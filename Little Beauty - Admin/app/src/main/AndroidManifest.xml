            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.main.MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.other.SessionOldInfoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.other.SessionNowInfoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.post.PostDetailsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.post.PostAddActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.other.SliderShowActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.shopping.ShoppingCentersActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.other.HotProductActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.user.UserDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.post.PostsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.user.UsersActivity"
