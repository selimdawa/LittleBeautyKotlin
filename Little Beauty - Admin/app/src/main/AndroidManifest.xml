<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="false"
        android:theme="@style/Theme.MC.S1"
        android:usesCleartextTraffic="true"
        android:windowSoftInputMode="adjustResize"
        tools:replace="android:supportsRtl">
        <activity
            android:name=".ui.main.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.other.ToolsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.profile.AboutMeActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.shopping.ShoppingCentresEditActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.shopping.ShoppingCentersAddActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.post.PostEditActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ads.ADsInfoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ads.ADsMeterActivity"
            android:screenOrientation="portrait" />
        <activity
